<% layout('layouts/main') %>
<% title = 'Home' %>

<section class="hero">
    <div class="hero-content">
        <h1>Welcome to AI-Powered Web Platform</h1>
        <p>A powerful platform for building intelligent, interactive applications with OpenAI integration.</p>
        <div class="hero-actions">
            <a href="/test" class="btn btn-primary">Try Demo</a>
            <a href="/login" class="btn btn-secondary">Sign In</a>
        </div>
    </div>
</section>

<section class="features">
    <h2>Features</h2>
    <div class="feature-grid">
        <div class="feature-card">
            <div class="feature-icon">🧠</div>
            <h3>OpenAI Integration</h3>
            <p>Leverage the power of OpenAI's API for intelligent content generation and analysis.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>Secure Authentication</h3>
            <p>Keep your data safe with our robust authentication and authorization system.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h3>PostgreSQL Database</h3>
            <p>Reliable data storage with PostgreSQL database integration for your application.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Fast Performance</h3>
            <p>Optimized for speed and efficiency to deliver a seamless user experience.</p>
        </div>
    </div>
</section>

<section class="cta">
    <h2>Ready to get started?</h2>
    <p>Join our platform today and experience the power of AI in your web applications.</p>
    <a href="/register" class="btn btn-primary">Register Now</a>
</section>