####################################
# Server Configuration
####################################
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

####################################
# Database Configuration (PostgreSQL)
####################################
# Connection string for PostgreSQL with all parameters
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Or individual PostgreSQL connection parameters
PGHOST=localhost
PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=dbname
# Enable SSL for production
PG_SSL=false

####################################
# OpenAI API Configuration
####################################
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o # The newest OpenAI model is gpt-4o, released May 13, 2024

####################################
# Logging Configuration
####################################
LOG_LEVEL=info # Possible values: error, warn, info, http, verbose, debug, silly

####################################
# Security Configuration
####################################
# Random string for signing cookies and tokens
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
# Token expiration time (in seconds)
JWT_EXPIRES_IN=86400

####################################
# Email Configuration (Optional)
####################################
# SMTP settings for sending emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com